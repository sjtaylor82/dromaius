{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dromaius",
  "version": "0.1.0",
  "identifier": "com.dromaius.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dromaius",
        "width": 900,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  }
}
